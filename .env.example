ADMIN_EMAIL=administracion@luanbazar.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_SITE_URL=https://your-domain.example
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/your-page
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/your-profile

# Meta catalog and measurement
# Public browser identifier. This is not a secret.
NEXT_PUBLIC_META_PIXEL_ID=
# Server-side copy of the same Pixel/Dataset ID.
META_PIXEL_ID=
META_CATALOG_ID=
# Set the current version shown by Meta Events Manager, for example vXX.X.
META_GRAPH_API_VERSION=
# Server only. Add this secret directly in Vercel, never to client code.
META_CONVERSIONS_API_TOKEN=
# Optional: use only while validating events in Meta Events Manager.
META_TEST_EVENT_CODE=

# Supabase project cxywdhdzmbjitprfgfyz
NEXT_PUBLIC_SUPABASE_URL=https://cxywdhdzmbjitprfgfyz.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never add NEXT_PUBLIC_ to this variable.
SUPABASE_SECRET_KEY=

# Product metadata and optional studio image generation
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.6
OPENAI_IMAGE_MODEL=gpt-image-2
